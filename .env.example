# Environment Variables Example
# Copy this file to .env and update values

NODE_ENV=development
PORT=3000

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here

# Database (when implementing real persistence)
# DATABASE_URL=postgresql://username:password@localhost:5432/database
# MONGODB_URI=mongodb://localhost:27017/database

# Email Configuration (for email APIs)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Payment Gateway (for payment APIs)
# STRIPE_SECRET_KEY=sk_test_...
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-secret

# File Storage (for file management APIs)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_BUCKET_NAME=your-s3-bucket
# AWS_REGION=us-east-1

# Push Notifications (for notification APIs)
# FCM_SERVER_KEY=your-fcm-server-key

# SMS Service (for notification APIs)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# External APIs (when integrating real services)
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# OPENWEATHER_API_KEY=your-openweather-key
# STRIPE_API_KEY=your-stripe-key

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Features
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# Cache (when implementing Redis)
# REDIS_URL=redis://localhost:6379

# Analytics
# GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX